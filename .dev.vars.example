# Cloudflare Worker local-development variables.
# Copy this file to .dev.vars and replace placeholders locally.
# Never commit .dev.vars or a real administrator credential.

# Generate an independent random value with at least 32 bytes of entropy.
ADMIN_TOKEN="replace_me_with_a_random_server_only_token"

# The Brain local API used by Relationship Manager durable memory persistence.
# Keep these values server-only. The scoped write token MUST be distinct from
# the general Brain API bearer token and must match The Brain's
# BRAIN_RELATIONSHIP_MEMORY_WRITE_TOKEN value.
BRAIN_BASE_URL="http://127.0.0.1:4317"
BRAIN_API_TOKEN="replace_me_with_a_distinct_random_brain_api_token"
BRAIN_RELATIONSHIP_MEMORY_WRITE_TOKEN="replace_me_with_a_distinct_random_memory_write_token"

# Optional future private-hub integration origin. Leave empty when unused.
PUBLIC_BASE_URL=""
