{
  "name": "evavo-outbound-agent",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init:local": "wrangler d1 execute evavo_outbound_agent --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute evavo_outbound_agent --file=./schema.sql --remote",
    "db:migrations:print": "node scripts/print-migration-commands.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "wrangler": "^4.66.0"
  }
}
